# ---- onboard-team ---------------------------------------------------------- #

# Scaffold an AITeam manifest into workloads/teams/<name>.yaml — the GitOps
# self-service path for onboarding a team (creates a team-<name> namespace with a
# GPU quota, RBAC, namespace isolation, and a scoped LiteLLM key). Mirrors
# new-model: without --deploy it writes the file locally + prints it for review
# (nothing pushed); with --deploy it also git-commits + pushes so ArgoCD applies
# it. Input is validated against the AITeam schema (platform/config/kro/
# team-onboarding.yaml) so bad values are caught here, not deep in the onboarding
# Job. This is a workloads-layer change only — it never touches infra or OSS
# component versions.
cmd_onboard_team() {
  local team="${1:-}"; shift || true
  [ -n "$team" ] && [ "${team#-}" = "$team" ] || die "usage: platformctl onboard-team <name> [flags]
  e.g. platformctl onboard-team search --gpu 4 --budget 500 --models qwen3-3b,claude-opus-4-8 --deploy
  flags: --models a,b (default *)  --budget USD (100.0)  --budget-duration 30d
         --rpm 100  --tpm 100000  --cpu 4  --memory 8Gi  --gpu 0
         --langfuse-secret NAME  --deploy  -y  --force"

  # Schema: teamName is ALSO the team-<name> namespace, so it must be a DNS-1123
  # label (<=40 chars) — reject here instead of failing namespace creation later.
  echo "$team" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$' \
    || die "invalid team name '${team}': must be a DNS-1123 label (lowercase alphanumeric/'-', start/end alphanumeric, <=40 chars)."

  local models_csv="" budget="100.0" dur="30d" rpm="100" tpm="100000"
  local cpu="4" mem="8Gi" gpu="0" lf="none" deploy=0 yes=0 force=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --models)          models_csv="${2:-}"; shift 2 ;;
      --budget)          budget="${2:-}"; shift 2 ;;
      --budget-duration) dur="${2:-}"; shift 2 ;;
      --rpm)             rpm="${2:-}"; shift 2 ;;
      --tpm)             tpm="${2:-}"; shift 2 ;;
      --cpu)             cpu="${2:-}"; shift 2 ;;
      --memory)          mem="${2:-}"; shift 2 ;;
      --gpu)             gpu="${2:-}"; shift 2 ;;
      --langfuse-secret) lf="${2:-}"; shift 2 ;;
      --deploy)          deploy=1; shift ;;
      -y|--yes)          yes=1; shift ;;
      --force)           force=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  # Validate the numeric/enum-ish fields the way the RGD schema does.
  echo "$budget" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || die "--budget must be a number (e.g. 100 or 100.0), got '${budget}'."
  echo "$rpm"    | grep -Eq '^[0-9]+$'            || die "--rpm must be an integer, got '${rpm}'."
  echo "$tpm"    | grep -Eq '^[0-9]+$'            || die "--tpm must be an integer, got '${tpm}'."
  echo "$gpu"    | grep -Eq '^[0-9]+$'            || die "--gpu must be an integer (0 = API-only team), got '${gpu}'."

  # Build the models list as a JSON array (default ["*"] = all models).
  local models_json='["*"]'
  if [ -n "$models_csv" ]; then
    local parts=() m IFS=','
    read -ra _mm <<< "$models_csv"
    for m in "${_mm[@]}"; do
      m="$(echo "$m" | tr -d '[:space:]')"; [ -n "$m" ] && parts+=("\"$m\"")
    done
    unset IFS
    [ "${#parts[@]}" -gt 0 ] && models_json="[$(printf '%s,' "${parts[@]}" | sed 's/,$//')]"
  fi

  local out="${REPO_ROOT}/workloads/teams/${team}.yaml"
  local lf_line=""
  [ "$lf" != "none" ] && [ -n "$lf" ] && lf_line=$'\n'"  langfuseSecretName: ${lf}"

  local manifest
  manifest="$(cat <<EOF
# AITeam '${team}' — generated by 'platformctl onboard-team'.
# Onboards the team: team-${team} namespace, GPU quota, RBAC, namespace
# isolation, and a scoped LiteLLM key (budget + rpm/tpm). Models this team
# deploys go under workloads/models/team-${team}/. Removal is 'git rm' this file.
apiVersion: kro.run/v1alpha1
kind: AITeam
metadata:
  name: ${team}
  namespace: ai-platform
spec:
  teamName: ${team}
  models: ${models_json}
  maxBudget: "${budget}"
  budgetDuration: "${dur}"
  rpmLimit: ${rpm}
  tpmLimit: ${tpm}
  cpuQuota: "${cpu}"
  memoryQuota: "${mem}"
  gpuQuota: ${gpu}${lf_line}
EOF
)"

  # Dry-run (no --deploy): print only, mirroring new-model. Nothing written/pushed.
  if [ "$deploy" -eq 0 ]; then
    echo "$manifest"
    echo
    log "Review the AITeam above. To apply it via GitOps:"
    echo "  • save it:      mkdir -p workloads/teams && printf '%s\n' \"…\" > workloads/teams/${team}.yaml"
    echo "  • or re-run:    ./platformctl onboard-team ${team} [flags] --deploy   # writes + commits + pushes"
    echo "  Then the team deploys models by committing VLLMEndpoints under workloads/models/team-${team}/."
    return 0
  fi

  # --deploy: write the file, then commit + push (ArgoCD applies it).
  need git
  if [ -e "$out" ] && [ "$force" -eq 0 ]; then
    die "refusing to overwrite existing ${out#"$REPO_ROOT"/} (pass --force to overwrite)."
  fi
  mkdir -p "${REPO_ROOT}/workloads/teams"
  printf '%s\n' "$manifest" > "$out"
  ok "wrote ${out#"$REPO_ROOT"/}"

  local branch; branch="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  if [ "$yes" -eq 0 ]; then
    echo
    warn "About to git commit + push '${out#"$REPO_ROOT"/}' to branch '${branch}'."
    echo "    Pushing to the GitOps branch triggers ArgoCD to onboard team '${team}' (creates its namespace, quota, and LiteLLM key)."
    read -r -p "Proceed with commit + push? Type 'yes' to continue (anything else = write only, no push): " go
    [ "$go" = "yes" ] || { warn "Left the file staged locally, nothing pushed. Commit it yourself when ready."; return 0; }
  fi
  git -C "$REPO_ROOT" add "$out"
  git -C "$REPO_ROOT" commit -m "Onboard team '${team}' (AITeam: gpu=${gpu}, budget=${budget}/${dur})" >/dev/null \
    || { warn "nothing to commit (file unchanged) — skipping push."; return 0; }
  git -C "$REPO_ROOT" push
  ok "pushed. ArgoCD will onboard team '${team}'. Watch it: kubectl get aiteams -n ai-platform -w"
}

# ---- use ------------------------------------------------------------------- #

# Switch the active env — the single action that aligns everything: records the
# intent in the state file (which resolve_env reads), pins the region, and points
# kubectl at that env's cluster. The one place we deliberately touch kubeconfig.
cmd_use() {
  local env="${1:-}"
  [ -n "$env" ] || die "usage: platformctl use <env>   (see: ./platformctl list-envs)"
  require_tfvars "$env"
  local region cluster
  region="$(tfvar_region "$env")"
  [ -n "$region" ] || die "env '${env}' has no 'region' in 00.global/vars/${env}.tfvars — add:  region = \"<aws-region>\""
  cluster="$(cluster_of "$env")"
  mkdir -p "$STATE_DIR"; printf '%s\n' "$env" > "$ACTIVE_ENV_FILE"
  ok "Active env → ${c_bold}${env}${c_rst}  (cluster ${cluster}, region ${region})"
  if command -v aws >/dev/null 2>&1; then
    if aws eks update-kubeconfig --name "$cluster" --region "$region" --alias "$env" >/dev/null 2>&1; then
      ok "kubectl context → ${env}"
    else
      warn "kubeconfig not updated — cluster '${cluster}' not found in ${region} (not provisioned yet?).
  Provision it with './platformctl up ${env}', then re-run './platformctl use ${env}'."
    fi
  fi
}

# ---- list-envs ------------------------------------------------------------- #

# List the configured environments (one per 00.global/vars/<env>.tfvars, minus
# the example templates) with their cluster + region, and highlight the active
# one (what verbs resolve to when [ENV] is omitted). Local files only — no AWS.
cmd_list_envs() {
  local vars_dir="${TF_DIR}/00.global/vars" active found=0 f env region cluster mark
  active=$(resolve_env "" 2>/dev/null || true)

  log "Environments (${vars_dir#"$REPO_ROOT"/}/<env>.tfvars)"
  for f in "$vars_dir"/*.tfvars; do
    [ -e "$f" ] || continue
    env="$(basename "$f" .tfvars)"
    case "$env" in example|example-*) continue ;; esac
    found=1
    region="$(tfvar_region "$env")"; cluster="$(cluster_of "$env")"
    if [ "$env" = "$active" ]; then mark="${c_grn}●${c_rst}"; else mark=" "; fi
    printf "  %b %-14s ${c_dim}%s  %s${c_rst}\n" "$mark" "$env" "${cluster:-?}" "${region:-<no region — add to tfvars>}"
  done
  [ "$found" -eq 1 ] || warn "no environments configured yet — copy ${vars_dir#"$REPO_ROOT"/}/example.tfvars to <env>.tfvars"

  echo
  if [ -n "$active" ]; then
    local src
    if [ -n "${PLATFORM_ENV:-}" ]; then src="\$PLATFORM_ENV"
    elif [ -s "$ACTIVE_ENV_FILE" ]; then src="./platformctl use"
    else src="the deployed Terraform workspace"; fi
    echo "${c_dim}Active: '${active}' (from ${src}) — used when [ENV] is omitted. Switch with ./platformctl use <env>.${c_rst}"
  else
    echo "${c_dim}No active env — set one with ./platformctl use <env> (or pass [ENV] / set PLATFORM_ENV).${c_rst}"
  fi
}

# ---- dispatch -------------------------------------------------------------- #

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    up)        cmd_up "$@" ;;
    use)       cmd_use "$@" ;;
    down)      cmd_down "$@" ;;
    status)    cmd_status "$@" ;;
    tunnel)    cmd_tunnel "$@" ;;
    edge)      cmd_edge "$@" ;;
    new-model) cmd_new_model "$@" ;;
    onboard-team) cmd_onboard_team "$@" ;;
    list-envs|envs) cmd_list_envs "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command: ${cmd}
$(usage)" ;;
  esac
}

main "$@"
